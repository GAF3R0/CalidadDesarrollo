# ===================================================
# CONFIGURACIÓN DEL SERVIDOR Y BASE DE DATOS
# Copia este archivo como .env y coloca tus valores reales
# ===================================================

# Puerto de ejecución del servidor
PORT=4001

# Conexión a Base de Datos PostgreSQL
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=replace_with_your_local_database_password
DB_NAME=Gestion
DB_DATABASE=Gestion
DB_PORT=5432

# Entorno de ejecución (development | production | test)
NODE_ENV=development

# Origen permitido para CORS (URL de tu frontend Vite)
FRONTEND_URL=http://localhost:5173

# Claves criptográficas locales (generar con: npm run keys:generate)
# Mantén Backend/keys fuera del repositorio y limita el acceso a estas llaves.
ENCRYPTION_KEY_PATH=./keys/encryption.key
JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem