# ===================================================
# CONFIGURACIÓN DEL SERVIDOR Y BASE DE DATOS
# Copia este archivo como .env y coloca tus valores reales
# ===================================================

# Puerto de ejecución del servidor
PORT=4001

# Conexión a Base de Datos PostgreSQL
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=tu_contraseña_aqui
DB_NAME=Gestion
DB_DATABASE=Gestion
DB_PORT=5432

# Entorno de ejecución (development | production | test)
NODE_ENV=development

# Origen permitido para CORS (URL de tu frontend Vite)
FRONTEND_URL=http://localhost:5173

# Clave secreta para firma y verificación de tokens JWT (usa una cadena larga y aleatoria)
JWT_SECRET=reemplazar_con_una_cadena_secreta_aleatoria_y_segura_de_al_menos_32_caracteres
